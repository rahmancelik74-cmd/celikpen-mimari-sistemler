{
  "name": "celikpen-bahcelievler-cam-balkon",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:ssl": "next dev --experimental-https",
    "build": "node -e \"process.env.NEXT_DIST_DIR='.next-build';require('child_process').execSync('npx next build',{stdio:'inherit'})\"",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "test:pricing": "node --experimental-strip-types tests/pricing.test.mjs"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "postcss-selector-parser": "^6.1.2"
  }
}
